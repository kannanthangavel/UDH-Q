{
  "name": "ud-qm",
  "version": "1.0.0",
  "description": "UD-QM - Udhayam Agencies Quotation Management (Paint Division)",
  "main": "server/src/server.js",
  "type": "commonjs",
  "scripts": {
    "server": "node server/src/server.js",
    "client": "vite --prefix client",
    "dev": "concurrently --kill-others-on-fail -n \"SERVER,CLIENT\" -c \"cyan,green\" \"npm run server\" \"npm run client\"",
    "start": "node server/src/server.js",
    "build": "npm --prefix client install && npm --prefix client run build",
    "vercel-build": "npm --prefix client install && npm --prefix client run build",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "xlsx": "^0.18.5"
  }
}
