{
  "name": "ud-qm",
  "version": "1.0.0",
  "description": "UD-QM - Udhayam Agencies Quotation Management Monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n \"BACKEND,FRONTEND\" -c \"cyan,green\" \"npm run backend\" \"npm run frontend\"",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "start": "npm --prefix backend start",
    "build": "npm --prefix frontend run build",
    "vercel-build": "npm --prefix frontend install && npm --prefix frontend run build",
    "test": "node --test tests/**/*.test.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "xlsx": "^0.18.5"
  }
}
