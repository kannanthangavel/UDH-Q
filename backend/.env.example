# UD-QM Backend Environment Configuration

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# SQLite Database Storage Location (optional override)
# DATABASE_PATH=backend/storage/ud_qm.sqlite
# STORAGE_DIR=/var/data/storage

# Security / Session Token
SESSION_SECRET=your_jwt_or_session_secret_key_here

# External Integrations (Meta WhatsApp Cloud API)
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=

# UD-QM Webhook / n8n Integration
UDQM_API_KEY=
N8N_WEBHOOK_URL=
