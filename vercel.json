{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://ud-qm-backend.onrender.com/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://ud-qm-backend.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://ud-qm-backend.onrender.com/uploads/:path*"
    },
    {
      "source": "/download/:path*",
      "destination": "https://ud-qm-backend.onrender.com/download/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
