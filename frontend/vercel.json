{
  "version": 2,
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://ud-qm-backend.onrender.com/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://ud-qm-backend.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://ud-qm-backend.onrender.com/uploads/$1"
    },
    {
      "source": "/download/(.*)",
      "destination": "https://ud-qm-backend.onrender.com/download/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
